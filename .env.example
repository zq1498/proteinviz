# Prediction backend: "colabfold" or "esmfold_api"
PREDICT_BACKEND=colabfold

# Full path to colabfold_batch *inside WSL* (not the Windows path)
COLABFOLD_BIN=/home/zach/localcolabfold/.pixi/envs/default/bin/colabfold_batch

# WSL distro name (check with: wsl --list)
WSL_DISTRO=Ubuntu

# ESM Atlas API base (no auth required as of writing)
ESM_ATLAS_URL=https://api.esmatlas.com/foldSequence/v1/pdb/

# DCC cluster MSA search
DCC_HOST=zq36@dcc-login.oit.duke.edu
DCC_KEY=~/.ssh/id_dcc
DCC_WORK=/work/zq36
DCC_CF_BIN=/work/zq36/localcolabfold/.pixi/envs/default/bin/colabfold_search
DCC_DB_DIR=/work/zq36/colabfold_db
