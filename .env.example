# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# Prediction backend
# ---------------------------------------------------------------------------

PREDICT_BACKEND=colabfold   # colabfold | esmfold_api

# ---------------------------------------------------------------------------
# DCC cluster — SSH access
# ---------------------------------------------------------------------------

DCC_HOST=zq36@dcc-login.oit.duke.edu
DCC_KEY=~/.ssh/id_ed25519
DCC_WORK=/work/zq36

# ---------------------------------------------------------------------------
# ColabFold on DCC — paths (all relative to DCC_WORK by default)
# ---------------------------------------------------------------------------

# Absolute path to 04_run_prediction.sh on DCC (set by install; rarely needs changing)
DCC_PREDICT_SCRIPT=/work/zq36/colabfold/install_scripts/04_run_prediction.sh

# Where per-job FASTA inputs and outputs land on DCC
DCC_CF_JOBS_DIR=/work/zq36/colabfold/jobs

# MMseqs2 database directory used by colabfold_search (MSA-only jobs via msa.py)
DCC_DB_DIR=/work/zq36/colabfold/databases

# ---------------------------------------------------------------------------
# ColabFold prediction parameters (can be overridden per-call via CLI flags)
# ---------------------------------------------------------------------------

CF_NUM_MODELS=5     # 1–5; reduce for quick screens
CF_NUM_RECYCLES=3   # AF2 recycling iterations; 6 for hard targets

# ---------------------------------------------------------------------------
# ESMFold API (no auth required; used only when PREDICT_BACKEND=esmfold_api)
# ---------------------------------------------------------------------------

ESM_ATLAS_URL=https://api.esmatlas.com/foldSequence/v1/pdb/

# ---------------------------------------------------------------------------
# Local paths
# ---------------------------------------------------------------------------

# Parent directory for jobs/, outputs/, and any local cache
PROTEINVIZ_DATA=/home/<your-user>/proteinviz/proteinviz_data
